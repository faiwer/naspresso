{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/exhaustive-deps": "error",
    "react/react-in-jsx-scope": "off",
    "no-shadow": "off"
  },
  "env": {
    "builtin": true,
    "browser": true
  }
}
